{
  "expo": {
    "name": "ATTY",
    "slug": "atty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/atty-icon.png",
    "scheme": "mobileapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/atty-icon.png",
      "bundleIdentifier": "com.veaglespace.atty",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "ATTY uses the camera to capture attendance selfies for face recognition verification and profile photo updates."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/atty-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.veaglespace.atty",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ea281884-8a26-4d8e-abed-5a4386ff21cf"
      }
    },
    "owner": "veaglespace1"
  }
}
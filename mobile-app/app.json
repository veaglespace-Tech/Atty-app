{
  "expo": {
    "name": "ATTY",
    "slug": "atty",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/veagle-space-logo.png",
    "scheme": "mobileapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "1",
      "icon": "./assets/images/veagle-space-logo.png",
      "bundleIdentifier": "com.veaglespace.atty",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "ATTY uses the camera to capture attendance selfies for face recognition verification and profile photo updates."
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/veagle-space-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.veaglespace.atty",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/veagle-space-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/veagle-space-logo.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ATTY needs your location to verify your presence at the designated work area when marking attendance."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ATTY uses the camera to capture attendance selfies for face recognition verification.",
          "microphonePermission": "Allow ATTY to access your microphone for video capture."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ATTY accesses your photo library to let you upload or update your profile picture."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ATTY uses Face ID / Touch ID for quick and secure login to your account."
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/veagle-space-logo.png",
          "color": "#208AEF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d782f29a-35b0-49b7-9d97-eedd9d486a98"
      }
    },
    "owner": "veaglespace"
  }
}